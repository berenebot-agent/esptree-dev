.agents/
logs/

# Local scratch for build artefacts, logs and one-off test output. Never commit.
# Temp work belongs here, inside the repo -- not in ad-hoc folders elsewhere.
.local/
*.local.log

# Support tooling lives outside the repo (sibling of this checkout, in the
# project's tools/ directory). Kept untracked so product code stays clean and
# the TCP serial bridge is not shipped.
tools/

# CMake/build output. Any of these directories is regenerated by
# `dev.sh build-cpp`; never commit compiled artefacts or CMakeCache.txt, which
# embeds absolute host paths.
build/
build*/
device_code/tests/build*/

# Local add-on data cache used by test/start.sh and test/start-ha.sh.
.cache/
